// X88 Pro RK3566 — Vendor prebuilt ELF modules
//
// Android 16 enforces that ELF prebuilts (binaries and shared libraries)
// must use cc_prebuilt_binary / cc_prebuilt_library_shared rather than
// PRODUCT_COPY_FILES. Non-ELF files (firmware, configs, .rc files) stay
// in PRODUCT_COPY_FILES in aosp_x88pro.mk.
//
// All modules here have:
//   vendor: true          — installs to /vendor partition
//   strip: { none: true } — already stripped, do not re-strip
//   check_elf_files: false — blobs from Android 11; dependency checking
//                           against Android 16 libraries would fail

// ============================================================
// GPU: ARM Mali-G52 Bifrost
// ============================================================

cc_prebuilt_library_shared {
    name: "libGLES_mali",
    vendor: true,
    srcs: ["proprietary/lib64/egl/libGLES_mali.so"],
    compile_multilib: "64",
    relative_install_path: "egl",
    strip: { none: true },
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "android.hardware.graphics.allocator@4.0-impl-bifrost",
    vendor: true,
    srcs: ["proprietary/lib64/hw/android.hardware.graphics.allocator@4.0-impl-bifrost.so"],
    compile_multilib: "64",
    relative_install_path: "hw",
    strip: { none: true },
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "android.hardware.graphics.mapper@4.0-impl-bifrost",
    vendor: true,
    srcs: ["proprietary/lib64/hw/android.hardware.graphics.mapper@4.0-impl-bifrost.so"],
    compile_multilib: "64",
    relative_install_path: "hw",
    strip: { none: true },
    check_elf_files: false,
}

