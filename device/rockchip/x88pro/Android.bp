// ============================================================
// WiFi: bcmdhd kernel module + static buffer dependency
// prebuilt_etc installs to /vendor/etc/modules/
// WIFI_DRIVER_MODULE_PATH in BoardConfig.mk must match this path.
// dhd_static_buf.ko is a dependency listed in bcmdhd.ko's modinfo.
// ============================================================

prebuilt_etc {
    name: "bcmdhd.ko",
    vendor: true,
    src: "proprietary/modules/bcmdhd.ko",
    sub_dir: "modules",
}

prebuilt_etc {
    name: "dhd_static_buf.ko",
    vendor: true,
    src: "proprietary/modules/dhd_static_buf.ko",
    sub_dir: "modules",
}

