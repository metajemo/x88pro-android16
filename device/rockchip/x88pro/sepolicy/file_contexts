# SELinux file contexts — X88 Pro RK3566
# Consumed by AOSP build via BOARD_SEPOLICY_DIRS

# rknn_server NPU inference daemon
/vendor/bin/rknn_server                             u:object_r:rknn_server_exec:s0

# bcmdhd WiFi kernel module
/vendor/lib/modules/bcmdhd\.ko                      u:object_r:vendor_file:s0

# rknpu kernel module (loads the NPU hardware driver, creates /dev/rknpu)
/vendor/lib/modules/rknpu\.ko                       u:object_r:vendor_file:s0
/vendor/lib/modules/rknpu-clang\.ko                 u:object_r:vendor_file:s0

# NPU device nodes (created by rknpu.ko at module load time)
/dev/rknpu[0-9]*                                    u:object_r:rknpu_device:s0
