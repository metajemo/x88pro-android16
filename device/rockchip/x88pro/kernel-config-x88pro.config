# X88 Pro RK3566 kernel config overlay
# Applied on top of rockchip_defconfig

# WiFi: bcmdhd (out-of-tree, confirmed from stock kernel)
CONFIG_BCMDHD=y
CONFIG_BCMDHD_FW_PATH="/vendor/etc/firmware/fw_bcmdhd.bin"
CONFIG_BCMDHD_NVRAM_PATH="/vendor/etc/firmware/nvram.txt"

# GPU: Mali-G52 Bifrost (Android mode)
CONFIG_MALI_BIFROST_FOR_ANDROID=y
# CONFIG_MALI_BIFROST_FOR_LINUX is not set
CONFIG_MALI_MEMORY_GROUP_MANAGER=y

# NPU: RKNPU (not in stock kernel - enable for Android 16)
CONFIG_RKNPU=y
CONFIG_RKNPU_JOB_PROC_STRATEGY=y

# Video: MPP / rkvdec2
CONFIG_ROCKCHIP_MPP_SERVICE=y
CONFIG_ROCKCHIP_MPP_RKVDEC2=y
CONFIG_ROCKCHIP_MPP_RKVENC=y
CONFIG_ROCKCHIP_MPP_VDPU2=y
CONFIG_ROCKCHIP_MPP_VEPU2=y
CONFIG_ROCKCHIP_IOMMU=y

# Security hardening
CONFIG_STACKPROTECTOR_STRONG=y
# CONFIG_FORTIFY_SOURCE is not set
# Disabled: BSP Mali Bifrost driver has string overflow that trips FORTIFY_SOURCE
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_RANDOMIZE_BASE=y

# Android requirements
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ASHMEM=y
CONFIG_SW_SYNC=y

# F2FS for userdata
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_ENCRYPTION=y
CONFIG_F2FS_FS_INLINE_ENCRYPT=y
